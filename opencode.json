{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "share": "manual",
  "skills": ["./.opencode/skills"],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "venv/**",
      "**/__pycache__/**",
      "*.egg-info/**",
      ".git/**",
      ".pi/**",
      ".private/**"
    ]
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "make clean_kernel", "effect": "ask" },
    { "action": "shell", "resource": "make reset_kernel", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf*", "effect": "ask" },
    { "action": "edit", "resource": "opencode.json", "effect": "ask" },
    { "action": "edit", "resource": "tui.json", "effect": "ask" },
    { "action": "edit", "resource": ".opencode/commands/*", "effect": "ask" },
    { "action": "edit", "resource": ".opencode/skills/*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "serial": {
        "type": "local",
        "command": ["/home/fdellorso/.npm-global/bin/embedded-serial-mcp"]
      }
    }
  },
  "lsp": {
    "clangd": {
      "command": ["clangd", "--background-index"],
      "extensions": [".c", ".h", ".cpp", ".hpp"]
    }
  },
  "model": "opencode-go/mimo-v2.6-flash",
  "agents": {
    "plan": {
      "model": "opencode-go/mimo-v2.6-pro"
    }
  }
}
