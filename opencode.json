{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "autoshare": false,
  "autoupdate": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "venv/**",
      "**/__pycache__/**",
      "*.egg-info/**",
      ".git/**"
    ]
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "git push": "ask",
      "git commit*": "ask",
      "make clean_kernel": "ask",
      "make reset_kernel": "ask",
      "rm -rf*": "ask",
      "*": "allow"
    }
  },
  "mcp": {
    "serial": {
      "type": "local",
      "command": ["/home/fdellorso/.npm-global/bin/embedded-serial-mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "clangd": {
      "command": ["clangd", "--background-index"],
      "extensions": [".c", ".h", ".cpp", ".hpp"]
    }
  },
  "model": "opencode-go/mimo-v2.5",
  "agent": {
    "plan": {
      "model": "opencode-go/mimo-v2.5-pro"
    }
  }
}
